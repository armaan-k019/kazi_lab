DATABASE_URL=
ANTHROPIC_API_KEY=
# External research integrations. All are keyless-capable and degrade honestly
# when absent (Semantic Scholar keyless = lower rate limit; ConceptNet, Datamuse,
# Crossref need no key). Never populate secrets in this example file.
SEMANTIC_SCHOLAR_API_KEY=
CONCEPTNET_BASE_URL=https://api.conceptnet.io
DATAMUSE_BASE_URL=https://api.datamuse.com
CROSSREF_MAILTO=
OPENALEX_MAILTO=
# Autonomous scheduler (Phase 1). All optional; the scheduler works without
# them using these documented defaults. INTERVAL is advisory in Phase 1 (the
# scheduler runs on demand; no daemon exists yet). BATCH_SIZE is reserved for
# a future cost-control pass; the metric CLI currently processes the full
# library idempotently (ONLY_MISSING).
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=60
METRIC_EXTRACTION_BATCH_SIZE=5
METRIC_EXTRACTION_TIMEOUT_SECONDS=3600
